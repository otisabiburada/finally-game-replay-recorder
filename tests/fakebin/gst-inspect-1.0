#!/usr/bin/env python3
import os, sys
name = sys.argv[1]
if os.environ.get('FAKE_LOG'): open(os.environ['FAKE_LOG'], 'a').write('gst-inspect ' + name + '\n')
have = os.environ.get("FAKE_ELEMENTS", "pipewiresrc,pulsesrc,h264parse,matroskamux,splitmuxsink,aacparse,videorate,audioconvert,audioresample,videoconvert,videoscale,fdsink,queue,vaapih264enc,x264enc,avenc_aac").split(",")
if name not in have:
    sys.stderr.write(f"No such element or plugin '{name}'\n"); sys.exit(1)
print(f"Factory Details:\n  Rank                     primary (256)\n\nElement Properties:\n")
for p in ("name","parent","bitrate","rate-control","keyframe-period","key-int-max","send-keyframe-requests","keepalive-time"):
    if p == "keepalive-time" and (os.environ.get("FAKE_NO_KEEPALIVE") or name != "pipewiresrc"): continue
    print(f"  {p:<20}: description of {p}\n{'':<24}flags: readable, writable\n")
print("Element Signals:\n  \"x\" :  void user_function (GstElement * object);")
